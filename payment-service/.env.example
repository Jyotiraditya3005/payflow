# ── Payment Service Environment Variables ──────────────────────────────────────
APP_NAME=PayFlow Payment Service
DEBUG=false
ENVIRONMENT=production

# Database (change credentials in production!)
DATABASE_URL=postgresql+asyncpg://payflow:CHANGE_ME@postgres:5432/payflow_payments

# Redis
REDIS_URL=redis://redis:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# JWT (MUST change in production — use: openssl rand -hex 32)
JWT_SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32

# Fraud Service
FRAUD_SERVICE_URL=http://fraud-service:8003

# Rate Limiting
RATE_LIMIT_MERCHANT_PER_MINUTE=1000

# Payment Limits
MAX_TRANSACTION_AMOUNT=1000000.0
MIN_TRANSACTION_AMOUNT=0.01
